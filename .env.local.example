# ---- Supabase (대시보드 > Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://jxmwamgfgqqsedhjvpwn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — 절대 커밋 금지, 서버(API Route)에서만 사용
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=jxmwamgfgqqsedhjvpwn

# ---- 게스트 자재 등록 (임시/로컬 전용) ----
# 1 로 켜면 로그인 없이 /materials 에 접근해 자재를 등록할 수 있다.
# RLS 는 그대로 두고 서버 라우트에서 service_role 로만 우회하므로 DB 정책 자체는 안전하지만,
# ⚠️ 공개된 주소에 켜 두면 누구나 자재를 등록할 수 있는 열린 업로드 경로가 된다. 기본값은 꺼짐.
# 켜려면 SUPABASE_SERVICE_ROLE_KEY 도 함께 설정돼 있어야 한다.
NEXT_PUBLIC_GUEST_MATERIALS=

# ---- 앱 ----
# 매직링크/OAuth 리다이렉트 기준 URL (배포 시 Vercel 도메인으로 변경)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
